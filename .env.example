NODE_ENV=development
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=changeme
DB_PASSWORD=changeme
DB_NAME=optilacteo_dev
PORT=3000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=45m
REFRESH_TOKEN_EXPIRES_DAYS=7
REFRESH_TOKEN_EXPIRES_DAYS_REMEMBER_ME=30
# Envio de mails transaccionales via API HTTPS de Brevo. No se usa SMTP
# porque Railway bloquea los puertos 25/465/587 en el plan Hobby.
# MAIL_FROM debe ser un remitente verificado en la cuenta de Brevo.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=OPTILACTEO
# HU-13: minutos sin lecturas antes de marcar un sensor (asociado a un lote
# en_proceso) como en falla por inactividad. Default si no se define: 5.
SENSOR_INACTIVIDAD_UMBRAL_MINUTOS=5
